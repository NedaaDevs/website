---
import Ledger from '@/components/svelte/OperationalLedger.svelte';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const labels = {
  period: t('ledger.period'),
  totalRequests: t('ledger.totalRequests'),
  availability: t('ledger.availability'),
  responseTime: t('ledger.responseTime'),
  percentiles: t('ledger.percentiles'),
  modules: t('ledger.modules'),
  module: t('ledger.module'),
  share: t('ledger.share'),
  percent: t('ledger.percent'),
  requests: t('ledger.requests'),
  lifetime: t('ledger.lifetime'),
  reciters: t('ledger.reciters'),
  recitations: t('ledger.recitations'),
  audio: t('ledger.audio'),
  intrusions: t('ledger.intrusions'),
  asOf: t('ledger.asOf'),
  note: t('ledger.note'),
  empty: t('ledger.empty'),
  loading: t('ledger.loading'),
  error: t('ledger.error'),
  over: t('ledger.over'),
  period24h: t('ledger.period.24h'),
  period7d: t('ledger.period.7d'),
  period30d: t('ledger.period.30d'),
};
---

<!--
  Hidden until the island confirms a usable PUBLIC_STATS_URL. The check cannot
  happen here: this HTML is emitted at build time, when the value is still the
  %%PUBLIC_STATS_URL%% sentinel that docker/runtime-env.sh swaps at container
  start. Starting hidden means an unconfigured deploy — or no JS at all —
  renders nothing instead of a permanently failing panel.
-->
<section class="section ledger" hidden>
  <div class="shell">
    <div class="head fx-rise">
      <div>
        <div class="almanac-rule" style="justify-content:flex-start">{t('ledger.section')}</div>
        <h2 class="h-1 ledger-title">{t('ledger.title')}</h2>
        <p class="body ledger-lead">{t('ledger.lead')}</p>
      </div>
    </div>

    <Ledger lang={lang} labels={labels} client:visible />
  </div>
</section>

<style>
  .ledger {
    background: var(--bg-muted);
    border-top: 1px solid var(--outline);
    border-bottom: 1px solid var(--outline);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 24px;
  }
  .ledger-title {
    margin-top: 8px;
  }
  .ledger-lead {
    margin-top: 12px;
    font-size: 16px;
    max-width: 60ch;
  }
</style>
